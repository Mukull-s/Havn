# Havn environment. Copy to .env at the repository root and fill in the keys.

# --- Voice providers -------------------------------------------------------
ELEVENLABS_API_KEY=
# Optional. Defaults to a warm, natural ElevenLabs voice compatible with free tier.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ElevenLabs realtime speech-to-text model.
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# ElevenLabs streaming text-to-speech model.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# --- LLM (set GROQ_API_KEY or GOOGLE_API_KEY; Groq takes priority when set) --
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional: set to "groq" or "gemini" to force a provider when both keys are set.
HAVN_LLM_PROVIDER=

# --- Application -----------------------------------------------------------
HAVN_HOST=127.0.0.1
HAVN_PORT=7860
HAVN_DB_PATH=backend/data/havn.db
HAVN_CLINIC_TZ=Asia/Kolkata
# Comma-separated browser origins allowed to call the REST API.
HAVN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (also settable in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:7860
NEXT_PUBLIC_VOICE_WS_URL=
